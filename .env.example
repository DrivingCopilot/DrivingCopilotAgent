# 이 파일을 복사해 .env로 만들고 값을 채우세요.
#   Mac/Linux: cp .env.example .env
#   Windows  : copy .env.example .env

# 로컬 모델 서버(app/model_server, OpenAI 호환) — Supervisor/Knowledge/Execution/
# Perception/Reflect/CRAG/Text2SQL/선호도 추출 LLM이 전부 이 서버 하나를 공유한다.
# 값 자체는 검증하지 않으니 그대로 둬도 된다(ChatOpenAI 생성자가 존재 여부만 확인).
OPENAI_API_KEY=sk-anything-local-model-server-ignores-this-value

# 아래는 기본값 그대로 써도 되면 생략 가능 (app/core/config.py 참고).
# MODEL_SERVER_URL=http://localhost:11500/v1
# QWEN_VL_MODEL_NAME=Qwen/Qwen2-VL-7B-Instruct
# QWEN_TEXT_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# 아래는 기본값 그대로 써도 되면 생략 가능 (app/core/config.py, app/a2a/registry.py 참고).
# 여러 서버를 다른 호스트/포트에 띄울 때만 값을 바꿔서 주석 해제하세요.
# AGENT_PORT=8001
# BACKEND_URL=http://localhost:8000
# MCP_SERVER_URL=http://127.0.0.1:9000/mcp
# SUPERVISOR_BASE_URL=http://localhost:8001
# KNOWLEDGE_BASE_URL=http://localhost:8002
# EXECUTION_BASE_URL=http://localhost:8003
# PERCEPTION_BASE_URL=http://localhost:8004
